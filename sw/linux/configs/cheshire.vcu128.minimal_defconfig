BR2_riscv=y
BR2_RISCV_ISA_RVC=y
BR2_BACKUP_SITE="http://sources.buildroot.net"
BR2_CPAN_MIRROR="http://cpan.metacpan.org"
BR2_CCACHE=y
BR2_CCACHE_DIR="$(TOPDIR)/buildroot-ccache"
BR2_OPTIMIZE_3=y
BR2_ENABLE_LTO=y
BR2_TARGET_GENERIC_ISSUE="Welcome to PULP Linux"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_PULP_LINUX_PATH)/target/common/rootfs"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_PULP_LINUX_PATH)/target/common/post-image.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.8.12"
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_PULP_LINUX_PATH)/target/common/patches/linux_v6.6_patch"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_PULP_LINUX_PATH)/target/cheshire-minimal/linux64_defconfig"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_PATH="$(BR2_EXTERNAL_PULP_LINUX_PATH)/target/cheshire-minimal/cheshire.genesys2.dts $(BR2_EXTERNAL_PULP_LINUX_PATH)/target/cheshire-minimal/cheshire.dtsi"
BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL_PULP_LINUX_PATH)/target/cheshire-minimal/busybox64.config"
BR2_PACKAGE_DHRYSTONE=y
BR2_PACKAGE_LMBENCH=y
BR2_PACKAGE_MEMSTAT=y
BR2_PACKAGE_RT_TESTS=y
BR2_PACKAGE_WHETSTONE=y
BR2_PACKAGE_NFS_UTILS=y
BR2_PACKAGE_LIBNFS=y
BR2_PACKAGE_ETHTOOL=y
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
BR2_PACKAGE_IPERF3=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_TCPDUMP=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
BR2_TARGET_ROOTFS_INITRAMFS=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_TARGET_OPENSBI=y
BR2_TARGET_OPENSBI_CUSTOM_GIT=y
BR2_TARGET_OPENSBI_CUSTOM_REPO_URL="https://github.com/pulp-platform/opensbi"
BR2_TARGET_OPENSBI_CUSTOM_REPO_VERSION="bluewww/cheshire"
BR2_TARGET_OPENSBI_PLAT="fpga/cheshire"
# BR2_TARGET_OPENSBI_INSTALL_DYNAMIC_IMG is not set
# BR2_TARGET_OPENSBI_INSTALL_JUMP_IMG is not set
BR2_TARGET_OPENSBI_UBOOT_PAYLOAD=y
BR2_TARGET_OPENSBI_ADDITIONAL_VARIABLES="FW_FDT_PATH=$(BR2_EXTERNAL_PULP_LINUX_PATH)/target/cheshire-minimal/cheshire.genesys2.dtb"
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_GIT=y
BR2_TARGET_UBOOT_CUSTOM_REPO_URL="https://github.com/pulp-platform/u-boot"
BR2_TARGET_UBOOT_CUSTOM_REPO_VERSION="cheshire"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="pulp-platform_cheshire"
BR2_TARGET_UBOOT_CUSTOM_DTS_PATH="$(BR2_EXTERNAL_PULP_LINUX_PATH)/target/cheshire-minimal/cheshire.genesys2.dts $(BR2_EXTERNAL_PULP_LINUX_PATH)/target/cheshire-minimal/cheshire.dtsi"
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_CACHETEST=y
BR2_PACKAGE_VITETRIS=y
